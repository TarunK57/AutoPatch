# Lumina Frontend - Production Static Container
FROM nginx:alpine

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy Lumina frontend files
COPY lumina/ /usr/share/nginx/html/

# Configure Nginx to serve on port 3000 with video streaming support
RUN printf 'server {\n\
    listen 3000;\n\
    server_name localhost;\n\
    location / {\n\
        root /usr/share/nginx/html;\n\
        index index.html index.htm;\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    location ~* \\.(mp4|webm|ogg)$ {\n\
        root /usr/share/nginx/html;\n\
        mp4;\n\
        mp4_buffer_size 1m;\n\
        mp4_max_buffer_size 10m;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
